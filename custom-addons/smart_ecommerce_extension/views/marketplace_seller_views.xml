<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- MARKETPLACE SELLER VIEWS -->
    <!-- ============================================================ -->
    
    <!-- Seller Form View -->
    <record id="view_marketplace_seller_form" model="ir.ui.view">
        <field name="name">marketplace.seller.form</field>
        <field name="model">marketplace.seller</field>
        <field name="arch" type="xml">
            <form string="Seller">
                <header>
                    <button name="action_add_product" string="Add Product"
                            type="object" class="btn-primary"
                            invisible="not can_do_commercial_actions"/>
                    <button name="action_submit_for_approval" string="Submit for Approval"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve"
                            type="object" class="btn-success"
                            invisible="state != 'pending'"
                            groups="sales_team.group_sale_manager"/>
                    <button name="action_reject" string="Reject"
                            type="object" class="btn-danger"
                            invisible="state != 'pending'"
                            groups="sales_team.group_sale_manager"/>
                    <button name="action_suspend" string="Suspend"
                            type="object" class="btn-warning"
                            invisible="state != 'approved'"
                            groups="sales_team.group_sale_manager"/>
                    <button name="action_reactivate" string="Reactivate"
                            type="object" class="btn-success"
                            invisible="state != 'suspended'"
                            groups="sales_team.group_sale_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <!-- KYC Alert Banner -->
                    <div class="alert alert-warning" role="alert"
                         invisible="can_do_commercial_actions or state in ('draft', 'rejected', 'suspended')">
                        <strong><i class="fa fa-exclamation-triangle"/> KYC Verification Required</strong>
                        <p class="mb-0">
                            <field name="commercial_status_message" readonly="1"/>
                        </p>
                    </div>
                    
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-cubes" type="object"
                                name="action_view_products">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-shopping-cart" type="object"
                                name="action_view_orders">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <!-- KYC Status Button -->
                        <button class="oe_stat_button" icon="fa-id-card" type="object"
                                name="action_verify_kyc"
                                invisible="kyc_verified or not kyc_doc"
                                groups="sales_team.group_sale_manager">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value text-warning">
                                    <i class="fa fa-clock-o"/>
                                </span>
                                <span class="o_stat_text">KYC Pending</span>
                            </div>
                        </button>
                        <div class="oe_stat_button" invisible="not kyc_verified">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value text-success">
                                    <i class="fa fa-check-circle"/>
                                </span>
                                <span class="o_stat_text">KYC Verified</span>
                            </div>
                        </div>
                    </div>
                    <field name="store_logo" widget="image" class="oe_avatar" options="{'preview_image': 'store_logo', 'size': [128, 128]}"/>
                    <div class="oe_title">
                        <label for="company_name"/>
                        <h1>
                            <field name="company_name" placeholder="Store/Company Name"/>
                        </h1>
                        <div class="text-muted" invisible="can_do_commercial_actions">
                            <field name="commercial_status_message" readonly="1"/>
                        </div>
                    </div>
                    
                    <group>
                        <group string="Account Information">
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group string="Business Information">
                            <field name="tax_id"/>
                            <field name="commission_rate"/>
                            <field name="rating" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Address">
                            <field name="street"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Banking">
                            <field name="bank_name"/>
                            <field name="bank_account"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- Tab 1: KYC & Documents -->
                        <page string="KYC &amp; Documents" name="documents">
                            <!-- KYC Status Banner -->
                            <div class="alert alert-success" role="alert" invisible="not kyc_verified">
                                <i class="fa fa-check-circle"/> <strong>KYC Verified</strong> - 
                                Verified on <field name="kyc_verified_date" readonly="1" widget="date"/> 
                                by <field name="kyc_verified_by" readonly="1" class="d-inline"/>
                            </div>
                            <div class="alert alert-warning" role="alert" 
                                 invisible="kyc_verified or not kyc_doc or kyc_rejection_reason">
                                <i class="fa fa-clock-o"/> <strong>KYC Pending Review</strong> - 
                                Documents have been submitted and are awaiting verification.
                            </div>
                            <div class="alert alert-danger" role="alert" invisible="not kyc_rejection_reason">
                                <i class="fa fa-times-circle"/> <strong>KYC Rejected</strong>
                                <p class="mb-0 mt-2"><field name="kyc_rejection_reason" readonly="1"/></p>
                            </div>
                            <div class="alert alert-info" role="alert" invisible="kyc_doc">
                                <i class="fa fa-info-circle"/> <strong>KYC Required</strong> - 
                                Please upload your KYC documents to enable product publishing and order management.
                            </div>
                            
                            <group>
                                <group string="KYC Document">
                                    <field name="kyc_doc" filename="kyc_doc_filename"/>
                                    <field name="kyc_doc_filename" invisible="1"/>
                                    <field name="kyc_status" widget="badge"
                                           decoration-success="kyc_status == 'verified'"
                                           decoration-warning="kyc_status == 'pending'"
                                           decoration-danger="kyc_status == 'rejected'"
                                           decoration-info="kyc_status == 'not_submitted'"/>
                                    <field name="kyc_verified" invisible="1"/>
                                    <field name="can_do_commercial_actions" string="Can Publish Products" 
                                           widget="boolean" readonly="1"/>
                                </group>
                                <group string="Business License">
                                    <field name="business_license" filename="business_license_filename"/>
                                    <field name="business_license_filename" invisible="1"/>
                                </group>
                            </group>
                            
                            <!-- KYC Action Buttons for Managers -->
                            <group string="KYC Actions" groups="sales_team.group_sale_manager"
                                   invisible="not kyc_doc">
                                <div class="d-flex gap-2">
                                    <button name="action_verify_kyc" string="✓ Verify KYC"
                                            type="object" class="btn btn-success"
                                            invisible="kyc_verified"/>
                                    <button name="action_reject_kyc" string="✗ Reject KYC"
                                            type="object" class="btn btn-danger"
                                            invisible="kyc_verified"/>
                                    <button name="action_request_kyc_resubmission" 
                                            string="↺ Request Resubmission"
                                            type="object" class="btn btn-warning"
                                            invisible="not kyc_verified"
                                            confirm="This will clear the current KYC documents and require the seller to resubmit. Continue?"/>
                                </div>
                            </group>
                        </page>
                        
                        <!-- Tab 2: Store Settings -->
                        <page string="Store Settings" name="store">
                            <group>
                                <field name="store_description" widget="html"/>
                            </group>
                            <group>
                                <group>
                                    <field name="store_banner" widget="image" options="{'size': [300, 100]}"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Tab 3: Products -->
                        <page string="Products" name="products">
                            <field name="product_ids" mode="kanban" context="{'default_seller_id': id, 'default_sale_ok': True}">
                                <kanban class="o_kanban_mobile">
                                    <field name="id"/>
                                    <field name="name"/>
                                    <field name="list_price"/>
                                    <field name="qty_available"/>
                                    <field name="availability_status"/>
                                    <field name="is_published"/>
                                    <field name="image_128"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="d-flex">
                                                <field name="image_128" widget="image" class="o_kanban_image" options="{'size': [64, 64]}"/>
                                                <div class="ms-2 flex-grow-1">
                                                    <strong><field name="name"/></strong>
                                                    <div class="text-primary fw-bold">
                                                        <field name="list_price" widget="monetary"/>
                                                    </div>
                                                    <div class="mt-1">
                                                        <span t-attf-class="badge #{record.availability_status.raw_value == 'in_stock' ? 'bg-success' : record.availability_status.raw_value == 'low_stock' ? 'bg-warning' : 'bg-danger'}">
                                                            <field name="availability_status"/>
                                                        </span>
                                                        <span t-if="record.is_published.raw_value" class="badge bg-info ms-1">Published</span>
                                                        <span t-if="!record.is_published.raw_value" class="badge bg-secondary ms-1">Draft</span>
                                                    </div>
                                                    <div class="text-muted small mt-1">
                                                        Stock: <field name="qty_available"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                            <div class="text-center mt-3" invisible="product_ids">
                                <p class="text-muted">No products yet. Click "Add Product" to create your first product.</p>
                            </div>
                        </page>
                        
                        <!-- Tab 4: Statistics -->
                        <page string="Statistics" name="stats">
                            <group>
                                <group>
                                    <field name="total_sales"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                                <group>
                                    <field name="approved_date"/>
                                    <field name="approved_by"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Status History" name="history"
                              invisible="state not in ('rejected', 'suspended')">
                            <group invisible="state != 'rejected'">
                                <field name="rejection_reason" readonly="1"/>
                            </group>
                            <group invisible="state != 'suspended'">
                                <field name="suspension_reason" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Seller List View -->
    <record id="view_marketplace_seller_tree" model="ir.ui.view">
        <field name="name">marketplace.seller.list</field>
        <field name="model">marketplace.seller</field>
        <field name="arch" type="xml">
            <list string="Sellers" 
                  decoration-muted="state == 'suspended'"
                  decoration-success="can_do_commercial_actions"
                  decoration-warning="state == 'pending' or (state == 'approved' and not kyc_verified)"
                  decoration-danger="state == 'rejected'">
                <field name="company_name"/>
                <field name="user_id"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="city"/>
                <field name="kyc_status" widget="badge"
                       decoration-success="kyc_status == 'verified'"
                       decoration-warning="kyc_status == 'pending'"
                       decoration-danger="kyc_status == 'rejected'"
                       decoration-info="kyc_status == 'not_submitted'"
                       string="KYC"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state in ('suspended', 'rejected')"/>
                <field name="can_do_commercial_actions" string="Active" widget="boolean"/>
                <field name="product_count"/>
                <field name="total_sales" sum="Total Sales"/>
                <field name="rating" widget="float" digits="[2,1]"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="kyc_verified" column_invisible="1"/>
            </list>
        </field>
    </record>
    
    <!-- Seller Kanban View -->
    <record id="view_marketplace_seller_kanban" model="ir.ui.view">
        <field name="name">marketplace.seller.kanban</field>
        <field name="model">marketplace.seller</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="id"/>
                <field name="company_name"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="store_logo"/>
                <field name="product_count"/>
                <field name="total_sales"/>
                <field name="rating"/>
                <field name="kyc_verified"/>
                <field name="kyc_status"/>
                <field name="can_do_commercial_actions"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <field name="store_logo" widget="image" class="o_kanban_image" options="{'size': [64, 64]}"/>
                            <div class="ms-2 flex-grow-1">
                                <strong><field name="company_name"/></strong>
                                <div class="text-muted small">
                                    <field name="user_id"/>
                                </div>
                                <div class="mt-1">
                                    <span class="badge bg-primary">
                                        <i class="fa fa-cubes me-1"/><field name="product_count"/> products
                                    </span>
                                </div>
                                <div class="mt-1">
                                    <!-- KYC Status Badges -->
                                    <span t-if="record.can_do_commercial_actions.raw_value" class="badge bg-success">
                                        <i class="fa fa-check-circle me-1"/>Active
                                    </span>
                                    <span t-elif="record.kyc_status.raw_value == 'verified'" class="badge bg-success">
                                        <i class="fa fa-check me-1"/>KYC ✓
                                    </span>
                                    <span t-elif="record.kyc_status.raw_value == 'pending'" class="badge bg-warning">
                                        <i class="fa fa-clock-o me-1"/>KYC Pending
                                    </span>
                                    <span t-elif="record.kyc_status.raw_value == 'rejected'" class="badge bg-danger">
                                        <i class="fa fa-times me-1"/>KYC Rejected
                                    </span>
                                    <span t-else="" class="badge bg-secondary">
                                        <i class="fa fa-id-card me-1"/>KYC Required
                                    </span>
                                </div>
                                <div class="mt-1">
                                    <field name="rating" widget="float" digits="[2,1]"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Seller Search View -->
    <record id="view_marketplace_seller_search" model="ir.ui.view">
        <field name="name">marketplace.seller.search</field>
        <field name="model">marketplace.seller</field>
        <field name="arch" type="xml">
            <search string="Search Sellers">
                <field name="company_name"/>
                <field name="user_id"/>
                <field name="email"/>
                <field name="city"/>
                <separator/>
                <!-- Quick Filters for KYC Status -->
                <filter string="Active (KYC Verified)" name="active_sellers" 
                        domain="[('can_do_commercial_actions', '=', True)]"
                        help="Sellers who are approved and KYC verified - can publish products"/>
                <filter string="Needs KYC Review" name="kyc_needs_review" 
                        domain="[('kyc_doc', '!=', False), ('kyc_verified', '=', False), ('kyc_rejection_reason', '=', False)]"
                        help="Sellers who have submitted KYC but are awaiting verification"/>
                <separator/>
                <!-- Account Status -->
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Approval" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Suspended" name="suspended" domain="[('state', '=', 'suspended')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <!-- KYC Status -->
                <filter string="KYC Verified" name="kyc_verified" domain="[('kyc_verified', '=', True)]"/>
                <filter string="KYC Pending" name="kyc_pending" domain="[('kyc_status', '=', 'pending')]"/>
                <filter string="KYC Rejected" name="kyc_rejected" domain="[('kyc_status', '=', 'rejected')]"/>
                <filter string="KYC Not Submitted" name="kyc_not_submitted" domain="[('kyc_status', '=', 'not_submitted')]"/>
                <separator/>
                <!-- Commercial Capability -->
                <filter string="Can Sell" name="can_sell" domain="[('can_do_commercial_actions', '=', True)]"/>
                <filter string="Cannot Sell" name="cannot_sell" domain="[('can_do_commercial_actions', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="KYC Status" name="group_kyc_status" context="{'group_by': 'kyc_status'}"/>
                    <filter string="City" name="group_city" context="{'group_by': 'city'}"/>
                    <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Seller Action -->
    <record id="action_marketplace_sellers" model="ir.actions.act_window">
        <field name="name">Sellers</field>
        <field name="res_model">marketplace.seller</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_approved': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No sellers registered yet
            </p>
            <p>
                Marketplace sellers will appear here once they register.
            </p>
        </field>
    </record>
    
    <!-- Pending Sellers Action -->
    <record id="action_marketplace_sellers_pending" model="ir.actions.act_window">
        <field name="name">Pending Approvals</field>
        <field name="res_model">marketplace.seller</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', '=', 'pending')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No pending seller approvals
            </p>
        </field>
    </record>
    
    <!-- ============================================================ -->
    <!-- WIZARD VIEWS -->
    <!-- ============================================================ -->
    
    <!-- Reject Wizard -->
    <record id="view_marketplace_seller_reject_wizard_form" model="ir.ui.view">
        <field name="name">marketplace.seller.reject.wizard.form</field>
        <field name="model">marketplace.seller.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Seller">
                <group>
                    <field name="seller_id" readonly="1"/>
                    <field name="reason" placeholder="Please provide a reason for rejection..."/>
                </group>
                <footer>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Suspend Wizard -->
    <record id="view_marketplace_seller_suspend_wizard_form" model="ir.ui.view">
        <field name="name">marketplace.seller.suspend.wizard.form</field>
        <field name="model">marketplace.seller.suspend.wizard</field>
        <field name="arch" type="xml">
            <form string="Suspend Seller">
                <group>
                    <field name="seller_id" readonly="1"/>
                    <field name="reason" placeholder="Please provide a reason for suspension..."/>
                </group>
                <footer>
                    <button name="action_suspend" string="Suspend" type="object" class="btn-warning"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- KYC Reject Wizard -->
    <record id="view_marketplace_seller_kyc_reject_wizard_form" model="ir.ui.view">
        <field name="name">marketplace.seller.kyc.reject.wizard.form</field>
        <field name="model">marketplace.seller.kyc.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject KYC Documents">
                <div class="alert alert-warning" role="alert">
                    <i class="fa fa-exclamation-triangle"/> 
                    Rejecting KYC will prevent the seller from publishing products and managing orders.
                </div>
                <group>
                    <field name="seller_id" readonly="1"/>
                    <field name="reason" widget="text" 
                           placeholder="Please explain why the KYC documents were rejected and what the seller needs to provide (e.g., 'Document is expired', 'Image is blurry', 'Missing business license')..."/>
                </group>
                <footer>
                    <button name="action_reject_kyc" string="Reject KYC" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

