<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- SELLER COMMISSION VIEWS -->
    <!-- ============================================================ -->

    <!-- Commission List View -->
    <record id="view_seller_commission_tree" model="ir.ui.view">
        <field name="name">seller.commission.tree</field>
        <field name="model">seller.commission</field>
        <field name="arch" type="xml">
            <list string="Seller Commissions"
                  decoration-success="state == 'paid'"
                  decoration-info="state == 'confirmed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="seller_id"/>
                <field name="order_id"/>
                <field name="order_date"/>
                <field name="order_amount" sum="Total Orders"/>
                <field name="commission_rate"/>
                <field name="commission_amount" sum="Total Commission"/>
                <field name="seller_earnings" sum="Total Earnings"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'paid'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="payout_date"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Commission Form View -->
    <record id="view_seller_commission_form" model="ir.ui.view">
        <field name="name">seller.commission.form</field>
        <field name="model">seller.commission</field>
        <field name="arch" type="xml">
            <form string="Seller Commission">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_mark_paid" string="Mark as Paid" type="object"
                            class="btn-success" invisible="state != 'confirmed'"
                            groups="sales_team.group_sale_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            class="btn-secondary" invisible="state in ('paid', 'cancelled')"/>
                    <button name="action_reset_to_pending" string="Reset to Pending" type="object"
                            class="btn-secondary" invisible="state not in ('confirmed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,confirmed,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Commission Details">
                            <field name="seller_id"/>
                            <field name="order_id"/>
                            <field name="order_date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Amounts">
                            <field name="order_amount"/>
                            <field name="commission_rate"/>
                            <field name="commission_amount"/>
                            <field name="seller_earnings" class="text-success fw-bold"/>
                        </group>
                    </group>
                    <group>
                        <group string="Payout Information" invisible="state != 'paid'">
                            <field name="payout_date"/>
                            <field name="payout_reference"/>
                            <field name="payout_method"/>
                        </group>
                        <group string="Tracking">
                            <field name="confirmation_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Additional notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Commission Search View -->
    <record id="view_seller_commission_search" model="ir.ui.view">
        <field name="name">seller.commission.search</field>
        <field name="model">seller.commission</field>
        <field name="arch" type="xml">
            <search string="Search Commissions">
                <field name="name"/>
                <field name="seller_id"/>
                <field name="order_id"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="This Month" name="this_month" 
                        domain="[('order_date', '>=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Last Month" name="last_month"
                        domain="[('order_date', '>=', (context_today() - relativedelta(months=1, day=1)).strftime('%Y-%m-%d')),
                                 ('order_date', '&lt;', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Seller" name="group_seller" context="{'group_by': 'seller_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Order Date" name="group_order_date" context="{'group_by': 'order_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Commission Pivot View -->
    <record id="view_seller_commission_pivot" model="ir.ui.view">
        <field name="name">seller.commission.pivot</field>
        <field name="model">seller.commission</field>
        <field name="arch" type="xml">
            <pivot string="Commission Analysis">
                <field name="seller_id" type="row"/>
                <field name="order_date" type="col" interval="month"/>
                <field name="order_amount" type="measure"/>
                <field name="commission_amount" type="measure"/>
                <field name="seller_earnings" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Commission Graph View -->
    <record id="view_seller_commission_graph" model="ir.ui.view">
        <field name="name">seller.commission.graph</field>
        <field name="model">seller.commission</field>
        <field name="arch" type="xml">
            <graph string="Commission Trend" type="bar">
                <field name="order_date" type="col" interval="month"/>
                <field name="commission_amount" type="measure"/>
                <field name="seller_earnings" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Commission Action -->
    <record id="action_seller_commissions" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">seller.commission</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No commissions yet
            </p>
            <p>
                Commissions are automatically created when orders are confirmed.
            </p>
        </field>
    </record>

    <!-- Pending Commissions Action -->
    <record id="action_seller_commissions_pending" model="ir.actions.act_window">
        <field name="name">Pending Commissions</field>
        <field name="res_model">seller.commission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pending')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No pending commissions
            </p>
        </field>
    </record>

    <!-- Confirmed Commissions (Ready to Pay) Action -->
    <record id="action_seller_commissions_ready_to_pay" model="ir.actions.act_window">
        <field name="name">Ready to Pay</field>
        <field name="res_model">seller.commission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'confirmed')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No commissions ready for payout
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- COMMISSION PAYOUT VIEWS -->
    <!-- ============================================================ -->

    <!-- Payout List View -->
    <record id="view_seller_commission_payout_tree" model="ir.ui.view">
        <field name="name">seller.commission.payout.tree</field>
        <field name="model">seller.commission.payout</field>
        <field name="arch" type="xml">
            <list string="Commission Payouts"
                  decoration-success="state == 'paid'"
                  decoration-info="state == 'confirmed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="seller_id"/>
                <field name="payout_method"/>
                <field name="commission_count"/>
                <field name="total_amount" sum="Total"/>
                <field name="payout_date"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'paid'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Payout Form View -->
    <record id="view_seller_commission_payout_form" model="ir.ui.view">
        <field name="name">seller.commission.payout.form</field>
        <field name="model">seller.commission.payout</field>
        <field name="arch" type="xml">
            <form string="Commission Payout">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_paid" string="Mark as Paid" type="object"
                            class="btn-success" invisible="state != 'confirmed'"
                            confirm="This will mark all included commissions as paid. Continue?"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            class="btn-secondary" invisible="state in ('paid', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Payout Details">
                            <field name="seller_id"/>
                            <field name="payout_method"/>
                            <field name="payout_date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Bank Information">
                            <field name="bank_name"/>
                            <field name="bank_account"/>
                        </group>
                    </group>
                    <group>
                        <group string="Summary">
                            <field name="commission_count"/>
                            <field name="total_amount" class="text-success fw-bold"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Commissions" name="commissions">
                            <field name="commission_ids" mode="tree" readonly="state != 'draft'">
                                <list>
                                    <field name="name"/>
                                    <field name="order_id"/>
                                    <field name="order_amount"/>
                                    <field name="commission_rate"/>
                                    <field name="seller_earnings"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes about this payout..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Payout Search View -->
    <record id="view_seller_commission_payout_search" model="ir.ui.view">
        <field name="name">seller.commission.payout.search</field>
        <field name="model">seller.commission.payout</field>
        <field name="arch" type="xml">
            <search string="Search Payouts">
                <field name="name"/>
                <field name="seller_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Seller" name="group_seller" context="{'group_by': 'seller_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Payout Method" name="group_method" context="{'group_by': 'payout_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Payout Action -->
    <record id="action_seller_commission_payouts" model="ir.actions.act_window">
        <field name="name">Payouts</field>
        <field name="res_model">seller.commission.payout</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first payout batch
            </p>
            <p>
                Group confirmed commissions into payouts for efficient payment processing.
            </p>
        </field>
    </record>
</odoo>
