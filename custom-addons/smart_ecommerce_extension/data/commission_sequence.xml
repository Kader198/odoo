<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ============================================================ -->
        <!-- COMMISSION SEQUENCES -->
        <!-- ============================================================ -->

        <!-- Seller Commission Sequence -->
        <record id="sequence_seller_commission" model="ir.sequence">
            <field name="name">Seller Commission</field>
            <field name="code">seller.commission</field>
            <field name="prefix">COM/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Commission Payout Sequence -->
        <record id="sequence_seller_commission_payout" model="ir.sequence">
            <field name="name">Commission Payout</field>
            <field name="code">seller.commission.payout</field>
            <field name="prefix">PAY/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
